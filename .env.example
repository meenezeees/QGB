# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Use SOMENTE a chave publishable (pública). Nunca coloque a service_role/secret key no frontend.
# Sem estas variáveis o site funciona em "modo local" (dados apenas no navegador).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
