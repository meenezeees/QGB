# ====================================================================
# QG BARBER — Variáveis de Ambiente
# ====================================================================
# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto:
# cp .env.example .env.local

# URL do projeto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima do Supabase (Project Settings > API > Project API Keys > anon / publishable)
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica-anon-aqui

# Webhook do n8n para disparo de automações de agendamento (WhatsApp, notificações, etc.)
VITE_N8N_WEBHOOK_URL=https://athrmnzs.app.n8n.cloud/webhook/agendamento
